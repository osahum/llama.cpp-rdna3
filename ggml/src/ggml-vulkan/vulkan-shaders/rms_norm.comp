#version 450

#include "generic_binary_head.glsl"
#include "types.glsl"

#extension GL_EXT_control_flow_attributes : enable
#if USE_SUBGROUP_ADD
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#endif
// llama-rdna: RMS_NORM_Q8_FUSION also emits the normalized, scaled rows as q8_1 blocks (what the following mat-vecs
// would quantize themselves); it needs clustered subgroup ops, so the non-subgroup build falls back to the plain path.
#if RMS_NORM_Q8_FUSION && USE_SUBGROUP_ADD
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_KHR_shader_subgroup_shuffle : require
#define RMS_Q8 1
#else
#define RMS_Q8 0
#endif

layout (constant_id = 3) const int BLOCK_SIZE = 512;
layout(local_size_x_id = 3, local_size_y = 1, local_size_z = 1) in;

#if RMS_NORM_ROPE_FUSION

layout (binding = 0) readonly buffer A {A_TYPE data_a[];};
layout (binding = 1) readonly buffer B {B_TYPE data_b[];};

// data is passed from rms_norm -> rope through shared memory.
// rms_norm calls this data_d, rope calls this rope_data_a.
// Binding 2 is not used
// host picks a block size such that ncols <= 2*BLOCK_SIZE
shared FLOAT_TYPE rope_data_a[2*BLOCK_SIZE];
#define data_d rope_data_a

layout (binding = 3) readonly buffer R_Y {int rope_data_pos[];};
layout (binding = 4) readonly buffer R_Z {float rope_data_ff[];};
layout (binding = 5) writeonly buffer R_D {ROPE_D_TYPE rope_data_d[];};
layout (binding = 6) readonly buffer R_I {uvec2 rope_data_i[];}; // indices for set_rows

#include "rope_params.glsl"
#include "rope_funcs.glsl"

#define GGML_ROPE_TYPE_NORMAL 0
#define GGML_ROPE_TYPE_NEOX   2
#define GGML_ROPE_TYPE_MROPE  8
#define GGML_ROPE_TYPE_VISION 24

#elif RMS_NORM_ADD_FUSION

layout (binding = 3) readonly buffer C {float data_c[];};
layout (binding = 4) readonly buffer E {float data_e[];};

#elif RMS_NORM_SET_ROWS_FUSION

layout (binding = 3) readonly buffer I {uvec2 data_i[];};

#elif RMS_NORM_MUL_MUL_FUSION

// llama-rdna: rms_norm(x) * w * e, e a tensor laid out like dst (the GDN output gate silu(z)); the second multiply of
// the separate MUL op, same order
layout (binding = 3) readonly buffer E {float data_e[];};

#elif RMS_NORM_Q8_FUSION

// block_q8_1_x4 layout, written exactly as quantize_q8_1_x4 writes it (one block per 32 columns)
layout (binding = 3) writeonly buffer Q8 {block_q8_1_x4 data_q8[];};

#endif

layout (constant_id = 1) const bool do_multiply = false;
#if RMS_NORM_ADD_FUSION
layout (constant_id = 2) const bool do_post_multiply = false;
#endif

shared FLOAT_TYPE sumsh[BLOCK_SIZE];

void rms_norm(uint num_iters) {
    const uint ncols     = p.ne00;
    const uint nrows     = gl_NumWorkGroups.x;
    const uint nchannels = p.ne02;
    const uint nsamples  = p.ne03;

    const uint row       = gl_WorkGroupID.x;
    const uint tid       = gl_LocalInvocationID.x;

    const uint stride_row       = p.nb01;
    const uint stride_channel   = p.nb02;
    const uint stride_sample    = p.nb03;

    // grid.y/z are clamped to the device workgroup limit, iterate over the excess channels/samples
    for (uint samp = gl_WorkGroupID.z; samp < nsamples; samp += gl_NumWorkGroups.z) {
        for (uint channel = gl_WorkGroupID.y; channel < nchannels; channel += gl_NumWorkGroups.y) {
            barrier();

            uint32_t a_offset = samp*stride_sample + channel*stride_channel + row*stride_row + get_aoffset();
            uint32_t b_offset = src1_idx(0, row, channel, samp) + get_boffset();
#if RMS_NORM_ROPE_FUSION
            // Per-row offset in shared memory
            uint32_t d_offset = 0;
#elif RMS_NORM_SET_ROWS_FUSION
            uint32_t d_offset = data_i[channel].x*p.nb21 + row*ncols + get_doffset();
#else
            uint32_t d_offset = ((samp*nchannels + channel)*nrows + row)*ncols + get_doffset();
#endif
            FLOAT_TYPE sum = FLOAT_TYPE(0.0f); // partial sum for thread in warp

            [[unroll]] for (uint col = tid, idx = 0; idx < num_iters; col += BLOCK_SIZE, ++idx) {
                FLOAT_TYPE xi = FLOAT_TYPE(0);
                if (col < ncols) {
                    xi = FLOAT_TYPE(data_a[a_offset + col]);
                }
                sum += xi * xi;
            }

            #if USE_SUBGROUP_ADD
                sum = subgroupAdd(sum);
                if (subgroupElect()) {
                    sumsh[gl_SubgroupID] = sum;
                }
                barrier();
                sum = FLOAT_TYPE(0.0f);
                if(gl_NumSubgroups <= 4) { // fast path to skip the 2nd subgroupAdd
                    [[unroll]] for(uint i=0; i < gl_NumSubgroups; ++i) {
                        sum += sumsh[i];
                    }
                }
                else {
                    // Each subgroup reads the partials, so one workgroup barrier is enough.
                    for (uint i = gl_SubgroupInvocationID; i < gl_NumSubgroups; i += gl_SubgroupSize) {
                        sum += sumsh[i];
                    }
                    sum = subgroupAdd(sum);
                }
            #else
                sumsh[tid] = sum;
                // sum up partial sums and write back result
                barrier();
                [[unroll]] for (int s = BLOCK_SIZE / 2; s > 0; s >>= 1) {
                    if (tid < s) {
                        sum += sumsh[tid + s];
                        sumsh[tid] = sum;
                    }
                    barrier();
                }
                sum = sumsh[0];
            #endif

            const FLOAT_TYPE mean = sum / FLOAT_TYPE(ncols);
            const FLOAT_TYPE scale = inversesqrt(mean + FLOAT_TYPE(p.param1));

            if (do_multiply) {
#if RMS_Q8
                // Columns are assigned by subgroup coordinates so the 32 lanes of a cluster hold 32 consecutive columns
                // (full subgroups; BLOCK_SIZE and ncols are multiples of 32). Each lane writes its f32 value and the
                // cluster quantizes one q8_1 block like quantize_q8_1.comp: d = amax / 127, q = round(v / d), ds = (d, sum(q) * d).
                const uint qtid = gl_SubgroupID * gl_SubgroupSize + gl_SubgroupInvocationID;
                const uint q8_base = ((samp*nchannels + channel)*nrows + row)*ncols;
                [[unroll]] for (uint col = qtid, idx = 0; idx < num_iters; col += BLOCK_SIZE, ++idx) {
                    FLOAT_TYPE value = FLOAT_TYPE(0);
                    if (col < ncols) {
                        const uint bcol = (ncols > p.ne10) ? fastmod(col, p.ne10) : col;
                        value = scale * FLOAT_TYPE(data_a[a_offset + col]) * FLOAT_TYPE(data_b[b_offset + bcol]);
                        data_d[d_offset + col] = D_TYPE(value);
                    }
                    const float v = float(value);
                    const float amax = subgroupClusteredMax(abs(v), 32);
                    const float d = amax / 127.0;
                    const float d_inv = d != 0.0 ? 1.0 / d : 0.0;
                    const float q = round(v * d_inv);
                    const float qsum = subgroupClusteredAdd(q, 32);
                    // lanes 4j gather their three neighbours (same 32-lane cluster, so the ids stay in range)
                    const float q1 = subgroupShuffle(q, gl_SubgroupInvocationID + 1);
                    const float q2 = subgroupShuffle(q, gl_SubgroupInvocationID + 2);
                    const float q3 = subgroupShuffle(q, gl_SubgroupInvocationID + 3);
                    if (col < ncols) {
                        const uint e = q8_base + col;
                        const uint ib = e / 32;
                        const uint il = e % 32;
                        if ((il & 3) == 0) {
                            data_q8[ib / 4].qs[(ib % 4) * 8 + il / 4] = pack32(i8vec4(ivec4(int(q), int(q1), int(q2), int(q3))));
                        }
                        if (il == 0) {
                            data_q8[ib / 4].ds[ib % 4] = f16vec2(vec2(d, qsum * d));
                        }
                    }
                }
#else
                if (ncols > p.ne10) {
                    [[unroll]] for (uint col = tid, idx = 0; idx < num_iters; col += BLOCK_SIZE, ++idx) {
                        if (col >= ncols) {
                            continue;
                        }
                        FLOAT_TYPE value = scale * FLOAT_TYPE(data_a[a_offset + col]) * FLOAT_TYPE(data_b[b_offset + fastmod(col, p.ne10)]);
#if RMS_NORM_MUL_MUL_FUSION
                        value *= FLOAT_TYPE(data_e[d_offset + col]);
#endif
#if RMS_NORM_ADD_FUSION
                        value += FLOAT_TYPE(data_c[d_offset + col]);
                        if (do_post_multiply) {
                            value *= FLOAT_TYPE(data_e[0]);
                        }
#endif
                        data_d[d_offset + col] = D_TYPE(value);
                    }
                } else {
                    [[unroll]] for (uint col = tid, idx = 0; idx < num_iters; col += BLOCK_SIZE, ++idx) {
                        if (col >= ncols) {
                            continue;
                        }
                        FLOAT_TYPE value = scale * FLOAT_TYPE(data_a[a_offset + col]) * FLOAT_TYPE(data_b[b_offset + col]);
#if RMS_NORM_MUL_MUL_FUSION
                        value *= FLOAT_TYPE(data_e[d_offset + col]);
#endif
#if RMS_NORM_ADD_FUSION
                        value += FLOAT_TYPE(data_c[d_offset + col]);
                        if (do_post_multiply) {
                            value *= FLOAT_TYPE(data_e[0]);
                        }
#endif
                        data_d[d_offset + col] = D_TYPE(value);
                    }
                }
#endif
            } else {
                [[unroll]] for (uint col = tid, idx = 0; idx < num_iters; col += BLOCK_SIZE, ++idx) {
                    if (col >= ncols) {
                        continue;
                    }
                    FLOAT_TYPE value = scale * FLOAT_TYPE(data_a[a_offset + col]);
                    // llama-rdna: RMS_NORM_SCALE fusion, param2 = the following SCALE's factor (0 = none); the same
                    // second multiply the separate SCALE op would do
                    if (p.param2 != 0.0f) {
                        value *= FLOAT_TYPE(p.param2);
                    }
                    data_d[d_offset + col] = D_TYPE(value);
                }
            }
#if RMS_NORM_ROPE_FUSION
            barrier();
            rope_params rp = p.rope;
            for (uint t = 2*tid; t < ncols; t += 2*BLOCK_SIZE) {
                if (rp.rope_mode == GGML_ROPE_TYPE_NEOX) {
                    rope_neox(t, row, channel, samp, rp);
                } else if (rp.rope_mode == GGML_ROPE_TYPE_NORMAL) {
                    rope_norm(t, row, channel, samp, rp);
                }
            }
#endif
        }
    }
}

void main() {
    // instantiate the rms_norm function for several different
    // dimensions, to allow loop unrolling
    uint num_blocks = (p.ne00 + BLOCK_SIZE - 1) / BLOCK_SIZE;
    if (num_blocks > 32) {
        rms_norm(num_blocks);
    } else if (num_blocks > 16) {
        rms_norm(32);
    } else if (num_blocks > 12) {
        rms_norm(16);
    } else if (num_blocks > 10) {
        rms_norm(12);
    } else if (num_blocks > 8) {
        rms_norm(10);
    } else if (num_blocks > 4) {
        rms_norm(8);
    } else if (num_blocks == 4) {
        rms_norm(4);
    } else if (num_blocks == 3) {
        rms_norm(3);
    } else if (num_blocks == 2) {
        rms_norm(2);
    } else if (num_blocks == 1) {
        rms_norm(1);
    }
}
